# M5Stack Cardputer ADV — Stamp-S3A (ESP32-S3FN8), 8 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# USB-C console (Stamp-S3 USB Serial/JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Custom partition table: factory launcher + room for packed ota_* apps
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Keep factory as the normal boot target. Apps are launched via deep-sleep +
# RTC retain (see boot_app) so power-off clears RTC and returns here even when
# catalog/Arduino apps call esp_ota_mark_app_valid_cancel_rollback().
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# M5GFX init is stack-heavy on the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Allow rewriting the partition table when deleting packed apps (0x8000 sector).
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ALLOWED=y

# Flash baud is not an sdkconfig knob on IDF 5.4+; scripts set ESPBAUD=921600.
